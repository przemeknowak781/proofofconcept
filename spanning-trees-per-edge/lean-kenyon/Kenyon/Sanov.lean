import Kenyon.Cayley
import Kenyon.Forest

/-!
# A 4-regular graph without short cycles

* `Reduced w`: no two consecutive letters of the word `w` are inverse to each other.
  `Act.run w v` applies the letters of `w` to `v` (the head of the list last).
* `Act.uW_eq_zero_of_free`: if no nonempty reduced word of length at most `J` fixes `v`, then
  the counters `uW v j v` vanish for `1 ≤ j ≤ J`.
* Integer vectors: the letters act by `(x, y) ↦ (x ± 2y, y)` and `(x, y) ↦ (x, y ± 2x)`.
  `sanov`: a nonempty reduced word moves a suitable vector with entries `0, 1` to a vector with
  an entry of square at least `4`, and its entries are at most `3^length`.
* The model: the group `HS n` of permutations of `(ℤ/n)²` generated by the two maps above, with
  the action `cayAct n` by right multiplication. `cay_free`: for `3^J + 1 < n` no nonempty
  reduced word of length at most `J` fixes a vertex. `cay_conn`: the graph is connected.
-/

open Finset

namespace Kenyon

/-- Reduced words. -/
def Reduced : List (Fin 4) → Prop
  | [] => True
  | [_] => True
  | s :: s' :: w => s' ≠ linv s ∧ Reduced (s' :: w)

theorem reduced_cons_cons (s s' : Fin 4) (w : List (Fin 4)) :
    Reduced (s :: s' :: w) ↔ s' ≠ linv s ∧ Reduced (s' :: w) := Iff.rfl

namespace Act

variable {V : Type} (A : Act V)

/-- The action of a word; the head of the list is applied last. -/
def run (w : List (Fin 4)) (v : V) : V := w.foldr (fun s x => A.mv s x) v

theorem run_cons (s : Fin 4) (w : List (Fin 4)) (v : V) :
    A.run (s :: w) v = A.mv s (A.run w v) := rfl

variable [DecidableEq V]

theorem exists_word_of_nu_ne_zero (v : V) : ∀ (j : ℕ) (x : V) (s : Fin 4), A.nu v j x s ≠ 0 →
    ∃ w : List (Fin 4), w.length = j ∧ Reduced (s :: w) ∧ A.run (s :: w) v = x
  | 0, x, s, h => by
      have hx : x = A.mv s v := by
        by_contra hne
        exact h (by simp [nu, hne])
      exact ⟨[], rfl, trivial, hx.symm⟩
  | j + 1, x, s, h => by
      rw [A.nu_succ_eq] at h
      obtain ⟨s', hs', hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero h
      obtain ⟨w, hw, hred, hrun⟩ := exists_word_of_nu_ne_zero v j _ s' hne
      refine ⟨s' :: w, by simp [hw], (reduced_cons_cons s s' w).2
        ⟨(Finset.mem_erase.1 hs').1, hred⟩, ?_⟩
      rw [run_cons, hrun, A.cancel']

theorem uW_eq_zero_of_free (v : V) (J : ℕ)
    (hfree : ∀ w : List (Fin 4), w ≠ [] → w.length ≤ J → Reduced w → A.run w v ≠ v) :
    ∀ j, 1 ≤ j → j ≤ J → A.uW v j v = 0 := by
  intro j h1 h2
  obtain ⟨i, rfl⟩ : ∃ i, j = i + 1 := ⟨j - 1, by omega⟩
  show ∑ s, A.nu v i v s = 0
  refine Finset.sum_eq_zero fun s _ => ?_
  by_contra hne
  obtain ⟨w, hw, hred, hrun⟩ := A.exists_word_of_nu_ne_zero v i v s hne
  exact hfree (s :: w) (List.cons_ne_nil _ _) (by simp [hw]; omega) hred hrun

end Act

/-! ### Integer vectors -/

/-- The action of a letter on an integer vector. -/
def lact (s : Fin 4) (p : ℤ × ℤ) : ℤ × ℤ :=
  ![(p.1 + 2 * p.2, p.2), (p.1 - 2 * p.2, p.2), (p.1, p.2 + 2 * p.1), (p.1, p.2 - 2 * p.1)] s

/-- The action of a word on an integer vector; the head of the list is applied first. -/
def ptZ : List (Fin 4) → ℤ × ℤ → ℤ × ℤ
  | [], p => p
  | s :: w, p => ptZ w (lact s p)

/-- The invariant after the letter `s`. -/
def Inv (s : Fin 4) (p : ℤ × ℤ) : Prop :=
  ![p.2 ^ 2 < p.1 ^ 2 ∧ 0 ≤ p.1 * p.2 ∧ 4 ≤ p.1 ^ 2,
    p.2 ^ 2 < p.1 ^ 2 ∧ p.1 * p.2 ≤ 0 ∧ 4 ≤ p.1 ^ 2,
    p.1 ^ 2 < p.2 ^ 2 ∧ 0 ≤ p.1 * p.2 ∧ 4 ≤ p.2 ^ 2,
    p.1 ^ 2 < p.2 ^ 2 ∧ p.1 * p.2 ≤ 0 ∧ 4 ≤ p.2 ^ 2] s

/-- The starting vector for a word whose first applied letter is `s`. -/
def p0 (s : Fin 4) : ℤ × ℤ := ![(0, 1), (0, 1), (1, 0), (1, 0)] s

theorem inv_start (s : Fin 4) : Inv s (lact s (p0 s)) := by
  fin_cases s <;> simp [Inv, lact, p0]

theorem inv_step (s s' : Fin 4) (hs : s' ≠ linv s) (p : ℤ × ℤ) (h : Inv s p) :
    Inv s' (lact s' p) := by
  obtain ⟨x, y⟩ := p
  fin_cases s <;> fin_cases s' <;> simp [linv] at hs <;> simp [Inv, lact] at h ⊢ <;>
    (obtain ⟨h1, h2, h3⟩ := h
     refine ⟨?_, ?_, ?_⟩ <;>
       nlinarith [sq_nonneg (x - y), sq_nonneg (x + y), sq_nonneg x, sq_nonneg y])

theorem inv_ptZ : ∀ (w : List (Fin 4)) (s : Fin 4) (p : ℤ × ℤ), Reduced (s :: w) → Inv s p →
    ∃ s', Inv s' (ptZ w p)
  | [], s, _, _, h => ⟨s, h⟩
  | s' :: w, s, p, hr, h =>
      inv_ptZ w s' (lact s' p) ((reduced_cons_cons s s' w).1 hr).2
        (inv_step s s' ((reduced_cons_cons s s' w).1 hr).1 p h)

/-- Both entries are at most `c` in absolute value. -/
def Bd (c : ℤ) (p : ℤ × ℤ) : Prop := |p.1| ≤ c ∧ |p.2| ≤ c

theorem bd_lact (s : Fin 4) (c : ℤ) (p : ℤ × ℤ) (h : Bd c p) : Bd (3 * c) (lact s p) := by
  obtain ⟨x, y⟩ := p
  obtain ⟨h1, h2⟩ := h
  simp only at h1 h2
  rw [abs_le] at h1 h2
  fin_cases s <;> simp only [lact, Bd] <;> simp <;> constructor <;> rw [abs_le] <;>
    constructor <;> linarith

theorem bd_ptZ : ∀ (w : List (Fin 4)) (c : ℤ) (p : ℤ × ℤ), Bd c p →
    Bd (3 ^ w.length * c) (ptZ w p)
  | [], c, p, h => by simpa [ptZ] using h
  | s :: w, c, p, h => by
      have h' := bd_ptZ w (3 * c) (lact s p) (bd_lact s c p h)
      have e : (3:ℤ) ^ (s :: w).length * c = 3 ^ w.length * (3 * c) := by
        simp [pow_succ]
        ring
      rw [e]
      exact h'

theorem bd_p0 (s : Fin 4) : Bd 1 (p0 s) := by
  fin_cases s <;> simp [Bd, p0]

theorem cast_ne {n : ℕ} {a b : ℤ} (hne : a ≠ b) (hlt : |b - a| < n) :
    (a : ZMod n) ≠ (b : ZMod n) := by
  intro h
  have h1 := (ZMod.intCast_eq_intCast_iff_dvd_sub a b n).1 h
  have h2 := Int.eq_zero_of_abs_lt_dvd h1 hlt
  omega

/-- The reduction of an integer vector. -/
def castP (n : ℕ) (p : ℤ × ℤ) : ZMod n × ZMod n := ((p.1 : ZMod n), (p.2 : ZMod n))

/-- **Sanov's argument.** A nonempty reduced word moves the starting vector, also modulo `n`
when `3^length + 1 < n`. -/
theorem sanov (s : Fin 4) (w : List (Fin 4)) (hr : Reduced (s :: w)) (n : ℕ)
    (hn : 3 ^ (w.length + 1) + 1 < n) :
    castP n (ptZ (s :: w) (p0 s)) ≠ castP n (p0 s) := by
  obtain ⟨s', hinv⟩ := inv_ptZ w s (lact s (p0 s)) hr (inv_start s)
  have hbd := bd_ptZ (s :: w) 1 (p0 s) (bd_p0 s)
  have hq : ptZ (s :: w) (p0 s) = ptZ w (lact s (p0 s)) := rfl
  rw [← hq] at hinv
  set q := ptZ (s :: w) (p0 s) with hqdef
  obtain ⟨b1, b2⟩ := hbd
  obtain ⟨c1, c2⟩ := bd_p0 s
  simp only [List.length_cons, mul_one] at b1 b2
  have hn' : ((3:ℤ) ^ (w.length + 1) + 1) < (n:ℤ) := by exact_mod_cast hn
  intro heq
  simp only [castP, Prod.mk.injEq] at heq
  have hsmall1 : |(p0 s).1 - q.1| < (n:ℤ) := by
    have := abs_sub (p0 s).1 q.1
    linarith
  have hsmall2 : |(p0 s).2 - q.2| < (n:ℤ) := by
    have := abs_sub (p0 s).2 q.2
    linarith
  -- one coordinate has square at least 4, the starting one at most 1
  have hp1 : (p0 s).1 ^ 2 ≤ 1 := by
    rw [abs_le] at c1
    nlinarith
  have hp2 : (p0 s).2 ^ 2 ≤ 1 := by
    rw [abs_le] at c2
    nlinarith
  have hcases : 4 ≤ q.1 ^ 2 ∨ 4 ≤ q.2 ^ 2 := by
    fin_cases s' <;> simp [Inv] at hinv
    · exact Or.inl hinv.2.2
    · exact Or.inl hinv.2.2
    · exact Or.inr hinv.2.2
    · exact Or.inr hinv.2.2
  rcases hcases with h4 | h4
  · have hne : q.1 ≠ (p0 s).1 := fun h => by
      rw [h] at h4
      linarith
    exact cast_ne hne hsmall1 heq.1
  · have hne : q.2 ≠ (p0 s).2 := fun h => by
      rw [h] at h4
      linarith
    exact cast_ne hne hsmall2 heq.2

/-! ### The model -/

variable (n : ℕ)

/-- The action of a letter on a vector modulo `n`. -/
def lactP (s : Fin 4) (q : ZMod n × ZMod n) : ZMod n × ZMod n :=
  ![(q.1 + 2 * q.2, q.2), (q.1 - 2 * q.2, q.2), (q.1, q.2 + 2 * q.1), (q.1, q.2 - 2 * q.1)] s

theorem lactP_cancel (s : Fin 4) (q : ZMod n × ZMod n) :
    lactP n (linv s) (lactP n s q) = q := by
  obtain ⟨x, y⟩ := q
  fin_cases s <;> simp [lactP, linv]

theorem castP_lact (s : Fin 4) (p : ℤ × ℤ) : castP n (lact s p) = lactP n s (castP n p) := by
  obtain ⟨x, y⟩ := p
  fin_cases s <;> simp [lact, lactP, castP]

/-- The letters as permutations of `(ℤ/n)²`. -/
def genP (s : Fin 4) : Equiv.Perm (ZMod n × ZMod n) where
  toFun := lactP n s
  invFun := lactP n (linv s)
  left_inv := lactP_cancel n s
  right_inv := fun q => by
    have h := lactP_cancel n (linv s) q
    rwa [linv_linv] at h

theorem genP_mul_linv (s : Fin 4) : genP n s * genP n (linv s) = 1 := by
  ext q : 1
  show lactP n s (lactP n (linv s) q) = q
  have h := lactP_cancel n (linv s) q
  rwa [linv_linv] at h

/-- The product of the generators along a word (head last). -/
def prodP : List (Fin 4) → Equiv.Perm (ZMod n × ZMod n)
  | [] => 1
  | s :: w => prodP w * genP n s

theorem prodP_apply : ∀ (w : List (Fin 4)) (p : ℤ × ℤ),
    prodP n w (castP n p) = castP n (ptZ w p)
  | [], _ => rfl
  | s :: w, p => by
      show prodP n w (lactP n s (castP n p)) = castP n (ptZ w (lact s p))
      rw [← castP_lact, prodP_apply w]

/-- The group generated by the two positive letters. -/
def HS : Subgroup (Equiv.Perm (ZMod n × ZMod n)) :=
  Subgroup.closure {genP n 0, genP n 2}

theorem genP_mem (s : Fin 4) : genP n s ∈ HS n := by
  have h0 : genP n 0 ∈ HS n := Subgroup.subset_closure (by simp)
  have h2 : genP n 2 ∈ HS n := Subgroup.subset_closure (by simp)
  have e1 : genP n 1 = (genP n 0)⁻¹ := eq_inv_of_mul_eq_one_right (genP_mul_linv n 0)
  have e3 : genP n 3 = (genP n 2)⁻¹ := eq_inv_of_mul_eq_one_right (genP_mul_linv n 2)
  fin_cases s
  · exact h0
  · show genP n 1 ∈ HS n
    rw [e1]
    exact (HS n).inv_mem h0
  · exact h2
  · show genP n 3 ∈ HS n
    rw [e3]
    exact (HS n).inv_mem h2

/-- The action of the letters on the group by right multiplication. -/
def cayAct : Act (HS n) where
  mv s x := x * ⟨genP n s, genP_mem n s⟩
  cancel s x := by
    apply Subtype.ext
    simp only [Subgroup.coe_mul]
    rw [mul_assoc, genP_mul_linv, mul_one]

theorem cay_run (w : List (Fin 4)) (v : HS n) :
    (((cayAct n).run w v : HS n) : Equiv.Perm (ZMod n × ZMod n)) = (v : Equiv.Perm _) * prodP n w := by
  induction w with
  | nil => simp [Act.run, prodP]
  | cons s w ih =>
    rw [Act.run_cons]
    show ((cayAct n).run w v : Equiv.Perm _) * genP n s = (v : Equiv.Perm _) * (prodP n w * genP n s)
    rw [ih, mul_assoc]

/-- **No short reduced word fixes a vertex.** -/
theorem cay_free (J : ℕ) (hn : 3 ^ J + 1 < n) (v : HS n) (w : List (Fin 4)) (hw : w ≠ [])
    (hlen : w.length ≤ J) (hr : Reduced w) : (cayAct n).run w v ≠ v := by
  intro h
  obtain ⟨s, w', rfl⟩ := List.exists_cons_of_ne_nil hw
  have h1 := cay_run n (s :: w') v
  rw [h] at h1
  have h2 : prodP n (s :: w') = 1 := by
    have := h1.symm
    rwa [mul_eq_left] at this
  have h3 := prodP_apply n (s :: w') (p0 s)
  rw [h2] at h3
  have hlen' : 3 ^ (w'.length + 1) + 1 < n := by
    have : 3 ^ (w'.length + 1) ≤ 3 ^ J := Nat.pow_le_pow_right (by norm_num) (by simpa using hlen)
    omega
  exact sanov s w' hr n hlen' h3.symm

variable [NeZero n]

/-- The group is finite. -/
noncomputable instance instFintypeHS : Fintype (HS n) := Fintype.ofFinite _

theorem conn_mul_left (x : HS n) {y z : HS n}
    (h : Conn Act.esrc (cayAct n).etgt univ y z) :
    Conn Act.esrc (cayAct n).etgt univ (x * y) (x * z) := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hbc ih =>
    obtain ⟨⟨a, i⟩, -, h⟩ := hbc
    refine Relation.ReflTransGen.tail ih ⟨(x * a, i), Finset.mem_univ _, ?_⟩
    simp only [Act.esrc, Act.etgt, cayAct] at h ⊢
    rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl ⟨by rw [h1], by rw [mul_assoc, h2]⟩
    · exact Or.inr ⟨by rw [h1], by rw [mul_assoc, h2]⟩

theorem conn_one : ∀ (g : Equiv.Perm (ZMod n × ZMod n)) (hg : g ∈ HS n),
    Conn Act.esrc (cayAct n).etgt univ (1 : HS n) ⟨g, hg⟩ := by
  intro g hg
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    have hx' : x = genP n 0 ∨ x = genP n 2 := by simpa using hx
    rcases hx' with rfl | rfl
    · refine Relation.ReflTransGen.single ⟨((1 : HS n), 0), Finset.mem_univ _, Or.inl ⟨rfl, ?_⟩⟩
      apply Subtype.ext
      simp [Act.etgt, cayAct, pos]
    · refine Relation.ReflTransGen.single ⟨((1 : HS n), 1), Finset.mem_univ _, Or.inl ⟨rfl, ?_⟩⟩
      apply Subtype.ext
      simp [Act.etgt, cayAct, pos]
  | one => exact Relation.ReflTransGen.refl
  | mul x y hx hy ihx ihy =>
    have h := conn_mul_left n ⟨x, hx⟩ ihy
    rw [mul_one] at h
    exact ihx.trans h
  | inv x hx ih =>
    have h := conn_mul_left n ⟨x⁻¹, (HS n).inv_mem hx⟩ ih
    rw [mul_one] at h
    have e : (⟨x⁻¹, (HS n).inv_mem hx⟩ : HS n) * ⟨x, hx⟩ = 1 := by
      apply Subtype.ext
      simp
    rw [e] at h
    exact h.symm

/-- **The graph is connected.** -/
theorem cay_conn (x y : HS n) : Conn Act.esrc (cayAct n).etgt univ x y :=
  (conn_one n x.1 x.2).symm.trans (conn_one n y.1 y.2)

end Kenyon
